{
  "name": "cyber-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/inline.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:artifact": "npm run build:single && node scripts/artifact.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
